# Copier vers /etc/slack-monitor.env (chmod 600) puis remplacer les valeurs.
# Ne jamais committer le fichier rempli.

SLACK_BOT_TOKEN=xoxb-remplacer-par-le-token-bot
SLACK_APP_TOKEN=xapp-remplacer-par-le-token-socket-mode
ALLOWED_SLACK_USERS=U0123456789
ALERT_CHANNEL=C0123456789

DEFAULT_NAMESPACE=default
MONITOR_INTERVAL=60
ALERT_COOLDOWN=900
CPU_THRESHOLD=90
RAM_THRESHOLD=90
DISK_THRESHOLD=85
